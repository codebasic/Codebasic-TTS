<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Codebasic TTS</string>
    <key>CFBundleDisplayName</key>
    <string>Codebasic TTS</string>
    <key>CFBundleIdentifier</key>
    <string>com.seongjoo.SelectedTextTTS</string>
    <key>CFBundleExecutable</key>
    <string>Codebasic TTS</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Start as a focus-safe agent; MainWindow flips to a Dock app (.regular)
         while its window is open. Keeps background Services playback from
         stealing focus. -->
    <key>LSUIElement</key>
    <true/>

    <!-- macOS Services registration. NSMessage maps to the selector
         readSelectedText:userData:error: in ServiceProvider.swift. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Codebasic TTS</string>
            </dict>
            <key>NSMessage</key>
            <string>readSelectedText</string>
            <key>NSPortName</key>
            <string>SelectedTextTTS</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
            <!-- Empty context dict = always available, regardless of app. -->
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
    </array>
</dict>
</plist>
